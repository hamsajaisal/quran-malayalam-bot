# Copy this file and rename it to .env for local testing
# On Railway, add these as environment variables in the dashboard
# Never upload your actual token to GitHub

BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram User IDs for bot administrators
# Admin commands (/stats, /broadcast, /backup) will only be accessible to these admin users.
ADMIN_IDS=12345678,987654321
